rules_version = '2';

// Each user can only read and write their own dive plans.
// Deploy: Firebase Console → Firestore → Rules (paste), or `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    match /divePlans/{planId} {
      function isOwner(data) {
        return request.auth != null && data.userId == request.auth.uid;
      }

      allow read, delete: if isOwner(resource.data);
      allow create:       if isOwner(request.resource.data);
      // userId can never be changed to someone else.
      allow update:       if isOwner(resource.data) && isOwner(request.resource.data);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
